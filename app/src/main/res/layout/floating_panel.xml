<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 悬浮球（始终显示） -->
    <FrameLayout
        android:id="@+id/floatingBall"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/floating_ball_bg"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="券"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 红点 -->
        <TextView
            android:id="@+id/badge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:visibility="visible" />
    </FrameLayout>

    <!-- 展开面板 -->
    <FrameLayout
        android:id="@+id/panelContent"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/panel_bg"
        android:elevation="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎫 券猎人"
                    android:textColor="#E02E24"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/closeBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#757575"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 统计行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/stats_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="今日已领" android:textColor="#757575" android:textSize="10sp" />
                    <TextView android:id="@+id/todayCount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#E02E24"
                        android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="30dp" android:background="#E0E0E0" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="累计搞券" android:textColor="#757575" android:textSize="10sp" />
                    <TextView android:id="@+id/totalCount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#FF6B00"
                        android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="30dp" android:background="#E0E0E0" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="状态" android:textColor="#757575" android:textSize="10sp" />
                    <TextView android:id="@+id/statusText"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="运行中" android:textColor="#4CAF50" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 记录标题 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📋 最近领取记录"
                android:textColor="#212121"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 记录列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:background="#FAFAFA" />

            <!-- 底部操作 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView android:id="@+id/toggleBtn"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginRight="3dp"
                    android:gravity="center"
                    android:background="@drawable/claim_btn_bg"
                    android:text="⏸ 暂停"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginLeft="3dp"
                    android:gravity="center"
                    android:background="@drawable/claim_btn_bg"
                    android:backgroundTint="#757575"
                    android:text="⏱ 静默运行中"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>